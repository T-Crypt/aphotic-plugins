{
  "plugins": [
    {
      "name": "agent-audit",
      "display_name": "Agent Audit",
      "description": "Inspect local agent run evidence, live activity, and replay timelines.",
      "version": "1.1.0",
      "category": "ai",
      "capabilities": [
        "ui-surface"
      ],
      "ui": {
        "surfaces": [
          {
            "surface": "workspace",
            "id": "agentAudit",
            "icon": "fact_check",
            "label": "Agent Audit",
            "component": "qml/AgentAuditWorkspace.qml",
            "requires_layer": "ai",
            "requires_data": "harness",
            "parent": "",
            "anchor": "",
            "width": 0,
            "height": 0,
            "trigger": ""
          }
        ]
      }
    },
    {
      "name": "agent-graph",
      "display_name": "Agent Graph",
      "description": "Live tool-call graph and run replay for AI coding harnesses (Claude Code, Codex).",
      "version": "1.7.0",
      "category": "ai",
      "capabilities": [
        "ui-surface"
      ],
      "ui": {
        "surfaces": [
          {
            "surface": "dashboard",
            "id": "agentGraph",
            "icon": "account_tree",
            "label": "Agent Graph",
            "component": "qml/AgentGraphTab.qml",
            "requires_layer": "ai",
            "requires_data": "harness",
            "parent": "",
            "anchor": "",
            "width": 0,
            "height": 0,
            "trigger": ""
          },
          {
            "surface": "settings",
            "id": "agentGraph",
            "icon": "account_tree",
            "label": "Agent Graph",
            "component": "qml/AgentGraphPane.qml",
            "requires_layer": "ai",
            "requires_data": "harness",
            "parent": "ai",
            "anchor": "",
            "width": 0,
            "height": 0,
            "trigger": ""
          }
        ]
      }
    },
    {
      "name": "claude-hooks",
      "display_name": "Claude Code Agent Hooks",
      "description": "Wires Claude Code into Aphotic's agent-hook contract for live per-session tracking in the bar/dashboard.",
      "version": "1.0.0",
      "category": "ai",
      "capabilities": [
        "harness-hook"
      ]
    },
    {
      "name": "llm-fit",
      "display_name": "Hardware Advisor",
      "description": "Hardware-aware local model recommendations from llmfit, with a one-click Ollama pull for the tags it confirms are real.",
      "version": "1.1.1",
      "category": "ai",
      "capabilities": [
        "harness-hook"
      ]
    },
    {
      "name": "direnv",
      "display_name": "direnv Notice",
      "description": "Notifies you when a project opened from the launcher has an .envrc, so you know to review/allow it.",
      "version": "0.1.0",
      "category": "dev",
      "capabilities": [
        "project-hook"
      ]
    },
    {
      "name": "live-wallpaper",
      "display_name": "Live Wallpapers",
      "description": "Plays video wallpapers on the desktop background, with the still frame Aphotic already derives its palette from underneath.",
      "version": "1.0.0",
      "category": "theming",
      "capabilities": [
        "ui-surface"
      ],
      "ui": {
        "background": {
          "id": "liveWallpaper",
          "icon": "movie",
          "label": "Live Wallpaper",
          "component": "qml/LiveWallpaperSurface.qml"
        },
        "settings_pane": {
          "id": "liveWallpaper",
          "icon": "movie",
          "label": "Live Wallpapers",
          "component": "qml/LiveWallpaperPane.qml",
          "parent": "appearance"
        }
      }
    },
    {
      "name": "opencode-hooks",
      "display_name": "OpenCode Agent Hooks",
      "description": "Wires OpenCode into Aphotic's agent-hook contract for live per-session tracking in the bar/dashboard, same contract as Claude Code.",
      "version": "1.1.0",
      "category": "ai",
      "capabilities": [
        "harness-hook"
      ]
    },
    {
      "name": "openrgb",
      "display_name": "OpenRGB Sync",
      "description": "Syncs the active theme's accent color to RGB PC lighting via OpenRGB.",
      "version": "1.0.0",
      "category": "theming",
      "capabilities": [
        "theme-hook"
      ]
    },
    {
      "name": "workspace-session-log",
      "display_name": "Workspace Session Log",
      "description": "Keeps a local, timestamped log of when each Workspace Profile is launched.",
      "version": "0.1.0",
      "category": "productivity",
      "capabilities": [
        "workspace-hook"
      ]
    }
  ]
}
