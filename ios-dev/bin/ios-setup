#!/usr/bin/env bash
# ios-dev/bin/ios-setup -- install the toolchain, one step at a time.
#
# Three rules shape this script:
#
#   1. It never runs sudo. Where a package manager needs privileges the
#      package manager asks for them itself, and the user sees it coming.
#   2. It never runs unattended. Without a terminal it prints what it
#      would do and stops. An install that pulls a 1 GB toolchain while
#      the user is away is not an install they agreed to.
#   3. It always stops before the SDK. The SDK lives inside Apple's Xcode
#      archive and that download needs a browser session, so no script can
#      carry it out. This prints the instruction and exits.
#
# Safe to re-run. Every step checks its own result first.

set -euo pipefail

. "$(cd "${BASH_SOURCE[0]%/*}" && pwd)/lib.sh"

_ios_yes() {
    local reply
    read -r -p "  $1 [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]]
}

_ios_step() {
    printf '\n== %s\n' "$1"
}

_ios_aur_helper() {
    command -v yay >/dev/null 2>&1 && { echo yay; return 0; }
    command -v paru >/dev/null 2>&1 && { echo paru; return 0; }
    return 0
}

# ---------------------------------------------------------------------------
_ios_pkg_step() {
    local pkg="$1" binary="$2" helper
    if command -v "$binary" >/dev/null 2>&1; then
        echo "  ok      ${pkg} (already installed)"
        return 0
    fi
    helper="$(_ios_aur_helper)"
    if [[ -z "$helper" ]]; then
        echo "  MISSING ${pkg}, and no AUR helper (yay or paru) is on PATH"
        echo "          install it yourself: sudo pacman -S ${pkg}"
        return 0
    fi
    echo "  ${pkg} is missing."
    if ! _ios_yes "Install ${pkg} now with ${helper}?"; then
        echo "  skipped. Run this again later, or: ${helper} -S ${pkg}"
        return 0
    fi
    "$helper" -S --needed "$pkg" || echo "  the install reported a failure; check the output above"
}

# ---------------------------------------------------------------------------
# The Xcode replacement, pinned by checksum because upstream publishes
# none. Extracted rather than mounted, because a mounted AppImage needs
# FUSE and a machine with no squashfs support cannot mount it. Measured on
# a host with no squashfs in /proc/filesystems: extraction works.
_ios_xtool_step() {
    if [[ -x "$_IOS_XTOOL" ]]; then
        echo "  ok      xtool $($_IOS_XTOOL --version 2>/dev/null | head -n1)"
        return 0
    fi

    local arch sha url tmp
    arch="$(uname -m)"
    case "$arch" in
        x86_64) sha="$_IOS_XTOOL_SHA_X86_64" ;;
        aarch64) sha="$_IOS_XTOOL_SHA_AARCH64" ;;
        *)
            echo "  xtool ships no prebuilt archive for ${arch}."
            echo "  Build it from source and place the binary at ${_IOS_XTOOL}"
            return 0
            ;;
    esac
    url="https://github.com/xtool-org/xtool/releases/download/${_IOS_XTOOL_VERSION}/xtool-${arch}.AppImage"

    echo "  xtool ${_IOS_XTOOL_VERSION} for ${arch} will be downloaded (about 55 MB)"
    echo "  and extracted to ${_IOS_XTOOL_DIR}"
    if ! _ios_yes "Download and install it now?"; then
        echo "  skipped. Get it yourself from ${url}"
        return 0
    fi

    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' RETURN

    if ! curl -fsSL --retry 2 --connect-timeout 20 -o "$tmp/xtool.AppImage" "$url"; then
        echo "  download failed. Nothing was written."
        return 0
    fi

    local got
    got="$(sha256sum "$tmp/xtool.AppImage" | cut -d' ' -f1)"
    if [[ "$got" != "$sha" ]]; then
        echo "  the download did not match the pinned checksum, so it was not installed."
        echo "    expected ${sha}"
        echo "    got      ${got}"
        echo "  Report this: the release asset may have been replaced."
        return 0
    fi

    chmod +x "$tmp/xtool.AppImage"
    (cd "$tmp" && ./xtool.AppImage --appimage-extract >/dev/null 2>&1) || {
        echo "  could not extract the archive. Nothing was written."
        return 0
    }

    rm -rf "$_IOS_XTOOL_DIR"
    mkdir -p "$_IOS_TOOLS_DIR"
    mv "$tmp/squashfs-root" "$_IOS_XTOOL_DIR"

    echo "  installed xtool $($_IOS_XTOOL --version 2>/dev/null | head -n1)"
}

_ios_path_step() {
    command -v xtool >/dev/null 2>&1 && { echo "  ok      xtool is already on PATH"; return 0; }
    [[ -d "$HOME/.local/bin" ]] || { echo "  ~/.local/bin does not exist, so there is nothing to add"; return 0; }
    echo "  Editors and agents look for xtool on PATH."
    if ! _ios_yes "Symlink ${_IOS_XTOOL} to ~/.local/bin/xtool?"; then
        echo "  skipped. Point your editor at ${_IOS_XTOOL} instead."
        return 0
    fi
    ln -sfn "$_IOS_XTOOL" "$HOME/.local/bin/xtool"
    echo "  linked ~/.local/bin/xtool"
}

# ---------------------------------------------------------------------------
main() {
    _ios_load_config

    _ios_step "Settings"
    local prefix apps
    prefix="$IOS_BUNDLE_PREFIX"
    apps="$IOS_APPS_DIR"
    read -r -p "  Bundle ID prefix for new apps [${prefix}] " reply_prefix
    read -r -p "  Folder for your iOS apps [${apps}] " reply_apps
    IOS_BUNDLE_PREFIX="${reply_prefix:-$prefix}"
    IOS_APPS_DIR="${reply_apps:-$apps}"
    _ios_save_config
    echo "  saved to ${_IOS_CONFIG}"

    _ios_step "usbmuxd"
    _ios_pkg_step usbmuxd usbmuxd

    _ios_step "inotify-tools"
    _ios_pkg_step inotify-tools inotifywait

    _ios_step "xtool"
    _ios_xtool_step
    _ios_path_step

    _ios_step "Swift toolchain"
    if command -v swift >/dev/null 2>&1; then
        echo "  ok      $(swift --version 2>/dev/null | head -n1)"
    else
        echo "  The Swift toolchain is about 1 GB and comes from the AUR."
        if _ios_yes "Install swift-bin now?"; then
            local helper
            helper="$(_ios_aur_helper)"
            if [[ -n "$helper" ]]; then
                "$helper" -S --needed swift-bin || echo "  the install reported a failure; check the output above"
            else
                echo "  no AUR helper on PATH. Install it yourself: yay -S swift-bin"
            fi
        else
            echo "  skipped. Install it later with: yay -S swift-bin"
        fi
    fi

    _ios_step "Darwin SDK"
    if command -v swift >/dev/null 2>&1 && swift sdk list 2>/dev/null | grep -qx darwin; then
        echo "  ok      $(swift sdk list 2>/dev/null | awk '/^darwin/{print $2; exit}')"
    else
        cat <<EOF

  This is the one step no script can do for you. Apple ships the iOS SDK
  only inside Xcode, and that download needs a signed-in browser.

    1. Open ${_IOS_XCODE_URL}
    2. Sign in with any Apple ID and pick the Xcode release whose version
       matches your Swift. Swift 6.4 needs Xcode 27. Swift 6.3 needs
       Xcode 26. A mismatch fails every build with "this SDK is not
       supported by the compiler".
    3. Save the .xip file, then run:

         xtool sdk install /path/to/Xcode_<version>.xip

  xtool is at ${_IOS_XTOOL}
EOF
    fi

    _ios_step "Result"
    _ios_state_refresh
    if _ios_toolchain_ready; then
        echo "  Everything is in place. Next: aphotic ios new MyApp"
    else
        echo "  Something is still missing. Run: aphotic ios doctor"
    fi
}

main "$@"
